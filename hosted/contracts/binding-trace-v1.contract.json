{
  "contract_id": "aios-binding-trace-v1",
  "schema_version": 1,
  "maturity": "PARTIAL",
  "canonical_workplan": "docs/os/h1_binding_trace_replay_workplan_ko.md",
  "slice_scope": {
    "implemented": [
      "transport boundary and limits",
      "strict JSONL parsing with duplicate-key rejection",
      "exact field-set, scalar-type, enum, and constant validation",
      "envelope sequence continuity and terminal structure arithmetic",
      "bounded Node 101 / Cell 1 lifecycle semantic replay",
      "claimed-outcome versus independently computed outcome comparison",
      "cross-axis validity, zero-sentinel, identity, generation, and retained-binding checks",
      "checked-in fixture manifest and self-contained verdict bundles",
      "fail-closed Linux/Windows bundle parity comparison",
      "Ubuntu/Windows CI configuration for transport, fixture, and parity lanes"
    ],
    "not_implemented_yet": [
      "live native lifecycle trace producer",
      "Linux hosted observe-only adapter (H2)",
      "remote terminal evidence for the configured Linux/Windows parity lane"
    ]
  },
  "transport": {
    "encoding": "utf-8",
    "bom_allowed": false,
    "allowed_line_endings": ["lf", "crlf"],
    "final_newline_required": true,
    "blank_lines_allowed": false,
    "max_line_bytes": 4096,
    "max_records": 64,
    "max_total_bytes": 262144,
    "flat_objects_only": true,
    "arrays_forbidden": true,
    "duplicate_keys_allowed": false,
    "line_length_counts": "line content bytes excluding an actual LF or CRLF terminator; an unterminated trailing CR remains content and is rejected as trace.encoding"
  },
  "scalar_types": {
    "u32": {
      "json_type": "integer",
      "min_value": 0,
      "max_value": 4294967295
    },
    "flag": {
      "json_type": "integer",
      "min_value": 0,
      "max_value": 1
    },
    "u64-decimal": {
      "json_type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "max_value_string": "18446744073709551615"
    },
    "trace-id": {
      "json_type": "string",
      "pattern": "^(?=.{1,64}$)[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "kebab-token": {
      "json_type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  },
  "enums": {
    "record_type": ["event", "terminal"],
    "event": ["discover", "bind", "observe", "update", "exit", "rebind"],
    "claimed_outcome": ["accepted", "rejected"],
    "claimed_reason": [
      "none",
      "init-order",
      "missing",
      "schema",
      "malformed",
      "overflow",
      "duplicate",
      "orphan",
      "namespace",
      "kind",
      "role",
      "instance",
      "zero-generation",
      "generation-rollback",
      "stale",
      "tail"
    ],
    "lifecycle_state": ["active", "exited"],
    "final_state": ["discovered", "bound", "exited"]
  },
  "constants": {
    "schema_version": 1,
    "observation_only": 1,
    "management_only": 1
  },
  "trusted_target_v1": {
    "note": "bounded H1 v1 projection mirrored from the K1/K2 C headers; C headers remain the numeric source of truth and host drift tests must fail closed",
    "canonical_namespace": "node",
    "canonical_id": "101",
    "canonical_kind": "ai-service",
    "canonical_generation": "1",
    "parent_cell_id": "1",
    "parent_generation": "1",
    "source_namespace": "native-slm-agent-tree",
    "source_kind": "ai-service",
    "source_role": "main",
    "native_source_id": "1",
    "native_source_instance": "1",
    "native_binding_generation": "1",
    "initial_source_generation": "1"
  },
  "records": {
    "event": {
      "fields_in_order": [
        { "name": "schema_version", "type": "u32" },
        { "name": "record_type", "type": "enum:record_type" },
        { "name": "trace_id", "type": "trace-id" },
        { "name": "trace_sequence", "type": "u32" },
        { "name": "host_instance", "type": "u64-decimal" },
        { "name": "event", "type": "enum:event" },
        { "name": "claimed_outcome", "type": "enum:claimed_outcome" },
        { "name": "claimed_reason", "type": "enum:claimed_reason" },
        { "name": "canonical_namespace", "type": "kebab-token" },
        { "name": "canonical_id", "type": "u64-decimal" },
        { "name": "canonical_kind", "type": "kebab-token" },
        { "name": "canonical_generation", "type": "u64-decimal" },
        { "name": "canonical_valid", "type": "flag" },
        { "name": "parent_cell_id", "type": "u64-decimal" },
        { "name": "parent_generation", "type": "u64-decimal" },
        { "name": "parent_valid", "type": "flag" },
        { "name": "producer_instance", "type": "u64-decimal" },
        { "name": "producer_owned", "type": "flag" },
        { "name": "copied_read", "type": "flag" },
        { "name": "source_namespace", "type": "kebab-token" },
        { "name": "source_id", "type": "u64-decimal" },
        { "name": "source_instance", "type": "u64-decimal" },
        { "name": "source_generation", "type": "u64-decimal" },
        { "name": "source_kind", "type": "kebab-token" },
        { "name": "source_role", "type": "kebab-token" },
        { "name": "source_valid", "type": "flag" },
        { "name": "bound_source_instance", "type": "u64-decimal" },
        { "name": "bound_source_generation", "type": "u64-decimal" },
        { "name": "binding_generation", "type": "u64-decimal" },
        { "name": "binding_valid", "type": "flag" },
        { "name": "binding_current", "type": "flag" },
        { "name": "kind_match", "type": "flag" },
        { "name": "role_match", "type": "flag" },
        { "name": "generation_valid", "type": "flag" },
        { "name": "lifecycle_state", "type": "enum:lifecycle_state" },
        { "name": "lifecycle_valid", "type": "flag" },
        { "name": "observed_at_ns", "type": "u64-decimal" },
        { "name": "observed_at_valid", "type": "flag" },
        { "name": "observation_only", "type": "flag" },
        { "name": "management_only", "type": "flag" }
      ]
    },
    "terminal": {
      "fields_in_order": [
        { "name": "schema_version", "type": "u32" },
        { "name": "record_type", "type": "enum:record_type" },
        { "name": "trace_id", "type": "trace-id" },
        { "name": "trace_sequence", "type": "u32" },
        { "name": "host_instance", "type": "u64-decimal" },
        { "name": "producer_instance", "type": "u64-decimal" },
        { "name": "record_count", "type": "u32" },
        { "name": "accepted_count", "type": "u32" },
        { "name": "rejected_count", "type": "u32" },
        { "name": "final_state", "type": "enum:final_state" },
        { "name": "final_binding_generation", "type": "u64-decimal" },
        { "name": "observation_only", "type": "flag" },
        { "name": "management_only", "type": "flag" }
      ]
    }
  },
  "string_mappings_v1": {
    "note": "native K2-a numeric meanings for the initial bounded projection; append-only registry, numeric equality across namespaces is forbidden",
    "canonical_namespace": { "node": 2 },
    "source_namespace": { "native-slm-agent-tree": 1 },
    "canonical_kind": { "ai-service": 1 },
    "source_kind": { "ai-service": 1 },
    "source_role": { "main": 1 },
    "lifecycle_state": { "active": 1 }
  },
  "outcome_pairing": {
    "accepted": ["none"],
    "rejected": [
      "init-order",
      "missing",
      "schema",
      "malformed",
      "overflow",
      "duplicate",
      "orphan",
      "namespace",
      "kind",
      "role",
      "instance",
      "zero-generation",
      "generation-rollback",
      "stale",
      "tail"
    ]
  },
  "trace_reasons_v1": [
    "trace.io",
    "trace.encoding",
    "trace.syntax",
    "trace.duplicate-key",
    "trace.missing-field",
    "trace.unknown-field",
    "trace.type",
    "trace.range",
    "trace.limit",
    "trace.truncated",
    "trace.sequence",
    "trace.trace-id",
    "trace.event",
    "trace.outcome",
    "trace.terminal",
    "trace.host-instance",
    "trace.producer-instance",
    "trace.source-reuse",
    "trace.state-transition",
    "trace.fixture-mismatch"
  ],
  "fixture_manifest_v1": {
    "top_level_fields_in_order": [
      "schema_version",
      "manifest_id",
      "contract_id",
      "fixtures"
    ],
    "fixture_fields_in_order": [
      "id",
      "trace",
      "evidence_kind",
      "expected_outcome",
      "expected_first_reason"
    ],
    "max_fixtures": 64,
    "fixture_id_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "evidence_kind": [
      "synthetic-lifecycle",
      "native-k2a-projection",
      "semantic-negative",
      "transport-negative"
    ],
    "expected_outcome": ["PASS", "FAIL"],
    "trace_suffix": ".jsonl",
    "path_style": "relative-posix-beneath-manifest-root"
  }
}
